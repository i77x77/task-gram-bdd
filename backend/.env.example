# SQLite-файл с данными
DATABASE_URL=sqlite:///./data/taskgram.db
# Ключ, который бот шлёт как "Authorization: Bearer <key>". Пусто = авторизация выключена
INGEST_API_KEY=change-me
# Пароль входа в веб-интерфейс. Пусто = без пароля
APP_PASSWORD=
# Секрет и адрес coturn (пусто = только STUN)
TURN_SECRET=
TURN_HOST=
# Разрешённые origin'ы фронта через запятую
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
