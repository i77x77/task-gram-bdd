BOT_TOKEN=123456:ABC-your-token-from-BotFather
# Общий секрет бота и бэкенда (Authorization: Bearer ...)
INGEST_API_KEY=change-me
# Пароль входа в веб-интерфейс (пусто = без пароля); бот тоже шлёт его при запросах к API
APP_PASSWORD=change-me-too
# TURN для звонков за строгим NAT: openssl rand -hex 16. TURN_HOST — публичный IP сервера
TURN_SECRET=change-me-three
# TURN_HOST=31.57.28.235
# Origin'ы фронта через запятую (необязательно)
# CORS_ORIGINS=http://localhost:3000

# LLM для разбора сообщений на задачи (vyceai, OpenAI-совместимый API)
# Список моделей: curl https://vyceai.com/v1/models -H "Authorization: Bearer $LLM_API_KEY"
LLM_API_KEY=sk-your-api-key
# LLM_BASE_URL=https://vyceai.com/v1
# LLM_MODEL=DeepSeek-V4.1-Flash

# Импорт презентаций из Google-таблицы (1-й столбец — название, 2-й — дата) в доску «Презентации», колонку To Do.
# Таблица должна быть открыта «всем, у кого есть ссылка — читатель». Пусто = выключено
# SHEET_URL=https://docs.google.com/spreadsheets/d/XXXX/edit#gid=0
